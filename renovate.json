{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "schedule": [
    "before 6am on monday"
  ],
  "labels": [
    "dependencies"
  ],
  "packageRules": [
    {
      "matchManagers": ["gradle", "gradle-wrapper"],
      "groupName": "android-gradle-dependencies",
      "addLabels": ["android"]
    },
    {
      "matchManagers": ["cargo"],
      "groupName": "aether-rust-dependencies",
      "addLabels": ["rust", "aether"]
    },
    {
      "matchManagers": ["npm"],
      "groupName": "panel-npm-dependencies",
      "addLabels": ["panel"]
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "github-actions",
      "addLabels": ["ci"]
    }
  ]
}
