// Cat Panel — one-file Cloudflare Worker.
//
// This config is the single source of truth for every deploy path:
//   • the README «Deploy to Cloudflare» button,
//   • `.github/workflows/deploy-worker.yml` (npx wrangler deploy),
//   • Cloudflare Workers Builds (GitHub integration — Workers & Pages →
//     your Worker → Settings → Build).
//
// main = the committed MINIFIED build (dist-panel/catpanel.min.js) — same code,
// ~127 KiB gzipped instead of the obfuscated snapshot's ~533 KiB, and readable
// on your own account. CI rebuilds it from the AGPL source on every push.
// The obfuscated snapshot (dist-panel/catpanel.obf.js) still exists for the
// in-app updater only; it is NOT deployed. The «Cloudflare scans worker sources
// and returns Error 1101» story that motivated it is a community hypothesis,
// not a documented Cloudflare behaviour — see scripts/panels/minify.mjs.
//
// Deploy command for Workers Builds (Settings → Build → Deploy command):
//     npx --yes wrangler@latest deploy --no-bundle
// `--no-bundle` uploads dist-panel/catpanel.min.js byte for byte. Without it
// Wrangler runs it through esbuild, which escapes every non-ASCII character
// (the panel is full of Persian text and emoji) and turns a 458 KiB upload into
// 602 KiB / 139.40 KiB gzipped instead of 458 KiB / 127.39 KiB gzipped.
// Verified with `wrangler deploy --dry-run` (wrangler 4.149.0), not on a live
// account.
{
  // The Worker name. ⚠ If you already run a panel under another name, put THAT
  // name here before connecting Workers Builds: Wrangler deploys to the name in
  // this file, so a mismatch creates a second Worker instead of updating yours.
  "name": "cat-panel",
  "main": "dist-panel/catpanel.min.js",
  // A snapshot date, not a version. Keep it at or below today's date. It is left
  // at the date the current panel code was deployed with on purpose: raising it
  // opts the Worker into newer runtime behaviour, which is a change to test on
  // your own account, not a cleanup.
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  // Workers Logs for the deployed panel (dashboards → your Worker → Logs).
  // Free-plan sampling applies; this only turns collection on.
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      // ─────────────────────────────────────────────────────────────────────
      // WHERE THE REAL KV ID GOES, if you want the binding pinned by id.
      //
      // Get it from: Cloudflare dashboard → Storage & Databases → KV →
      //              your namespace → the ID field (32 hex characters), or
      //              `npx wrangler kv namespace list`.
      // Then uncomment the line below and paste it between the quotes:
      //
      // "id": "0123456789abcdef0123456789abcdef",
      //
      // Leave it commented and Wrangler provisions/keeps the namespace itself
      // (automatic provisioning: a KV binding declared without an id is created
      // on first deploy, and stays linked across later deploys — Cloudflare
      // docs, «Automatic provisioning»).
      //
      // ⚠ Do NOT commit a made-up id. A placeholder string in an ACTIVE "id"
      // field is not a placeholder to Wrangler, it is a binding that cannot
      // resolve, and the deploy fails instead of provisioning. That is why this
      // one sits behind a comment. scripts/panels/wrangler-config.test.mjs
      // enforces the rule: a committed id must be 32 hex characters.
      // ─────────────────────────────────────────────────────────────────────
      "binding": "CAT_KV"
    }
  ],
  "triggers": {
    // Repo library feeds refresh themselves every 12 hours (plus lazy refresh on panel open).
    "crons": ["0 */12 * * *"]
  },
  "vars": {
    // Fresh installs start open; set a panel password in Tools → settings.
    "OPEN_PANEL": "true",
    "OPEN_SUB": "true"
  }
}
