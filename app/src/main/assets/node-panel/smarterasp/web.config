<?xml version="1.0" encoding="UTF-8"?>
<!--
  Cat Panel on SmarterASP.NET (Windows Server / IIS). IIS starts `node index.js` through httpPlatformHandler
  (SmarterASP's documented way, KB 1970) and forwards every request to it, WebSocket included.
  The rewrite tags each URL with {HTTPS} and the client address so the panel knows https from http (see
  iisEdge in index.js); index.js puts the original URL back. Data and the downloaded panel stay in App_Data,
  the folder IIS lets the site write and never serves.
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
    </handlers>
    <httpPlatform processPath="node" arguments="index.js" startupTimeLimit="120" startupRetryCount="3"
                  requestTimeout="02:00:00" stdoutLogEnabled="true" stdoutLogFile=".\App_Data\cat-node.log">
      <environmentVariables>
        <environmentVariable name="PORT" value="%HTTP_PLATFORM_PORT%" />
        <environmentVariable name="NODE_ENV" value="production" />
        <environmentVariable name="CAT_BEHIND_IIS" value="1" />
        <environmentVariable name="CAT_DATA_DIR" value="App_Data\cat-data" />
        <environmentVariable name="CAT_CODE_DIR" value="App_Data\cat-code" />
      </environmentVariables>
    </httpPlatform>
    <rewrite>
      <rules>
        <rule name="cat-edge" stopProcessing="true">
          <match url=".*" />
          <action type="Rewrite" url="/__cat_edge/{HTTPS}/{REMOTE_ADDR}{UNENCODED_URL}" appendQueryString="false" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
