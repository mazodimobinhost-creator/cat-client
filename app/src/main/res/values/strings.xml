    <string name="cloud_title">My Panel</string>
    <string name="cloud_intro">Deploy Cat Panel — your own panel — on your Cloudflare account with one API token, then use the Scanner tab for clean IPs. Server-based panels are listed below with install guides.</string>
    <string name="cloud_token_hint">Cloudflare API Token</string>
