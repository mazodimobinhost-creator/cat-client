{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "cat-account-portal",
  "main": "src/_worker.js",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "cat-portal", "database_id": "REPLACE_WITH_D1_DATABASE_ID" }],
  "vars": { "PORTAL_URL": "https://portal.example.invalid" },
  "triggers": { "crons": ["23 3 * * *"] },
  "observability": { "enabled": true }
}
